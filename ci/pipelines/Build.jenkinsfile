@Library('aid-pipeline-utils@1.0.23') _

def version = "0.0.0"
def packageNameInterface = "trace-api"
def profile = "vs2022.conanprofile"
def archs = [ 'x86', 'x86_64']
def configs = ['Debug', 'Release']
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}
 				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build/${config}-${arch}"
								bat script: "conan install . --output-folder ${buildFolder} --profile:all ${profile} --settings:all arch=${arch} --settings:all build_type=${config}", label: 'Installing dependencies'
								bat script: "conan build . --output-folder ${buildFolder} --profile:all ${profile} --settings:all arch=${arch} --settings:all build_type=${config}", label: 'Building'					
								bat script: "conan export-pkg . --name ${packageNameInterface} --version ${version} --profile:all ${profile} --settings:all arch=${arch} --settings:all build_type=${config} --output-folder ${buildFolder}", label: "Exporting package ${packageNameInterface}/${version}"
								dir("${buildFolder}/bin/${config}/")
								{
									bat "TraceAPITest.exe --gtest_output=xml:TraceAPITest.xml"
								}
							}
						}
					}
				}
			}
		}
		
		stage('Test Packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							bat script: "conan test test_package/conanfile.py ${packageNameInterface}/${version} --profile:all ${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
						}
					}
				}
			}
		}
		
		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script:"conan upload ${packageNameInterface}/${version} --remote aid-conan-production-local --confirm --force", label: "Uploading ${packageNameInterface} package to Artifactory"
				}
			}
		}
	}
	
	post
		{
			always
			{
				junit allowEmptyResults: true, testResults: "build*/TraceAPITest.xml"
				script
				{
					currentBuild.description = "${version}"
				}
				cleanupWorkspace()
			}
		}
}