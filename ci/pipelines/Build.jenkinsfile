@Library('aid-pipeline-utils@1.0.23') _

def version = "0.0.0"
def packageNameInterface = "trace-api"
def profile = "vs2022.conanprofile"
def archs = [ 'x86', 'x86_64']
def configs = ['Debug', 'Release']
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}
 				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								withEnv(["GTEST_OUTPUT=xml:${env.WORKSPACE}\\build\\TraceAPITest-${config}-${arch}.xml"])
								{
									bat script: "conan create . --version ${version} --profile:all ${profile} --settings:all arch=${arch} --settings:all build_type=${config}", label: "Creating package ${packageNameInterface}/${version}"
								}
							}
						}
					}
				}
			}
		}
		
		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script:"conan upload ${packageNameInterface}/${version} --remote aid-conan-production-local --confirm --force", label: "Uploading ${packageNameInterface} package to Artifactory"
				}
			}
		}
	}
	
	post
		{
			always
			{
				junit allowEmptyResults: true, testResults: "build/TraceAPITest-*.xml"
				script
				{
					currentBuild.description = "${version}"
				}
				cleanupWorkspace()
			}
		}
}